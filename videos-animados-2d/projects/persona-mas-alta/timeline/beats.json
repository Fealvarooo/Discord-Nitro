[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.66,
  "text": "Te golpeas con la lámpara, el frasco del estante más alto.",
  "end": 4.01
 },
 {
  "i": 1,
  "start": 4.01,
  "speechStart": 4.16,
  "speechEnd": 7.4,
  "text": "Sólo lo bajas y saludas a la lámpara.",
  "end": 7.93
 },
 {
  "i": 2,
  "start": 7.93,
  "speechStart": 8.08,
  "speechEnd": 11.74,
  "text": "La persona promedio mide alrededor de un metro setenta. ¿Tú?",
  "end": 12.07
 },
 {
  "i": 3,
  "start": 12.07,
  "speechStart": 12.22,
  "speechEnd": 13.88,
  "text": "Dos metros setenta y cinco.",
  "end": 14.17
 },
 {
  "i": 4,
  "start": 14.17,
  "speechStart": 14.32,
  "speechEnd": 15.8,
  "text": "Más que el récord histórico.",
  "end": 16.11
 },
 {
  "i": 5,
  "start": 16.11,
  "speechStart": 16.26,
  "speechEnd": 17.64,
  "text": "Dos metros setenta y dos.",
  "end": 17.99
 },
 {
  "i": 6,
  "start": 17.99,
  "speechStart": 18.14,
  "speechEnd": 20.9,
  "text": "Pero hay una regla. Tu cuerpo creció.",
  "end": 21.27
 },
 {
  "i": 7,
  "start": 21.27,
  "speechStart": 21.42,
  "speechEnd": 22.7,
  "text": "Tus rodillas, no.",
  "end": 23.07
 },
 {
  "i": 8,
  "start": 23.07,
  "speechStart": 23.22,
  "speechEnd": 25.82,
  "text": "Tu peso crece más rápido que tus huesos.",
  "end": 26.11
 },
 {
  "i": 9,
  "start": 26.11,
  "speechStart": 26.26,
  "speechEnd": 29.34,
  "text": "¿Y qué pasaría si fueras la persona más alta del mundo?",
  "end": 29.19
 },
 {
  "i": 10,
  "start": 29.19,
  "speechStart": 29.34,
  "speechEnd": 34.16,
  "text": "A favor, un aro de básquet está a tres metros con cinco centímetros.",
  "end": 34.51
 },
 {
  "i": 11,
  "start": 34.51,
  "speechStart": 34.66,
  "speechEnd": 36.62,
  "text": "Lo tocas sin saltar.",
  "end": 36.91
 },
 {
  "i": 12,
  "start": 36.91,
  "speechStart": 37.06,
  "speechEnd": 41.52,
  "text": "En contra, las puertas miden unos dos metros. Tu frente lo sabe.",
  "end": 41.93
 },
 {
  "i": 13,
  "start": 41.93,
  "speechStart": 42.08,
  "speechEnd": 45.38,
  "text": "Las camas suelen medir un metro noventa. ¿El problema?",
  "end": 45.79
 },
 {
  "i": 14,
  "start": 45.79,
  "speechStart": 45.94,
  "speechEnd": 51.82,
  "text": "Tu corazón empuja sangre mucho más arriba. Y la gente mira. ¿Tu hermanito Leo? No.",
  "end": 52.11
 },
 {
  "i": 15,
  "start": 52.11,
  "speechStart": 52.26,
  "speechEnd": 53.88,
  "text": "Él pregunta siempre lo mismo.",
  "end": 54.27
 },
 {
  "i": 16,
  "start": 54.27,
  "speechStart": 54.42,
  "speechEnd": 55.8,
  "text": "¿Cómo está el clima allá arriba?",
  "end": 56.25
 },
 {
  "i": 17,
  "start": 56.25,
  "speechStart": 56.4,
  "speechEnd": 62.88,
  "text": "En la feria, entre miles de personas, Leo desaparece. Tu celular suena. El entrenador.",
  "end": 63.17
 },
 {
  "i": 18,
  "start": 63.17,
  "speechStart": 63.32,
  "speechEnd": 66.38,
  "text": "Prueba final en diez minutos. No puedes correr.",
  "end": 66.75
 },
 {
  "i": 19,
  "start": 66.75,
  "speechStart": 66.9,
  "speechEnd": 68.42,
  "text": "Tus rodillas no aguantan.",
  "end": 68.75
 },
 {
  "i": 20,
  "start": 68.75,
  "speechStart": 68.9,
  "speechEnd": 73.36,
  "text": "El contrato o tu hermano cuelgas. Te subes a una banca.",
  "end": 73.69
 },
 {
  "i": 21,
  "start": 73.69,
  "speechStart": 73.84,
  "speechEnd": 75.9,
  "text": "Tus ojos quedan a casi tres metros.",
  "end": 76.33
 },
 {
  "i": 22,
  "start": 76.33,
  "speechStart": 76.48,
  "speechEnd": 79.7,
  "text": "Una gorra roja llorando. Lo levantas.",
  "end": 79.99
 },
 {
  "i": 23,
  "start": 79.99,
  "speechStart": 80.14,
  "speechEnd": 83.02,
  "text": "¿Cómo está el clima allá arriba? Despejado, Leo.",
  "end": 83.35
 },
 {
  "i": 24,
  "start": 83.35,
  "speechStart": 83.5,
  "speechEnd": 85.58,
  "text": "Ahora sí, llega un mensaje.",
  "end": 85.43
 },
 {
  "i": 25,
  "start": 85.43,
  "speechStart": 85.58,
  "speechEnd": 88.56,
  "text": "Alguien más alto que tú te está buscando.",
  "end": 89.21
 },
 {
  "i": 26,
  "start": 89.21,
  "speechStart": 89.36,
  "speechEnd": 90.96,
  "text": "¿Y tú qué harías con esa altura?",
  "end": 91.39
 },
 {
  "i": 27,
  "start": 91.39,
  "speechStart": 91.54,
  "speechEnd": 93.86,
  "text": "Cuéntanos qué alcanzarías primero en los comentarios.",
  "end": 94.25
 },
 {
  "i": 28,
  "start": 94.25,
  "speechStart": 94.4,
  "speechEnd": 98.78,
  "text": "Y si Leo te sacó una sonrisa, dale like y suscríbete para la parte dos.",
  "end": 100.28
 }
]