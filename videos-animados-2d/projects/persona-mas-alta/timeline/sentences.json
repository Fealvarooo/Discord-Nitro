[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.66,
  "text": "Te golpeas con la lámpara, el frasco del estante más alto."
 },
 {
  "i": 1,
  "start": 4.16,
  "end": 7.4,
  "text": "Sólo lo bajas y saludas a la lámpara."
 },
 {
  "i": 2,
  "start": 8.08,
  "end": 10.94,
  "text": "La persona promedio mide alrededor de un metro setenta."
 },
 {
  "i": 3,
  "start": 11.56,
  "end": 11.74,
  "text": "¿Tú?"
 },
 {
  "i": 4,
  "start": 12.22,
  "end": 13.88,
  "text": "Dos metros setenta y cinco."
 },
 {
  "i": 5,
  "start": 14.32,
  "end": 15.8,
  "text": "Más que el récord histórico."
 },
 {
  "i": 6,
  "start": 16.26,
  "end": 17.64,
  "text": "Dos metros setenta y dos."
 },
 {
  "i": 7,
  "start": 18.14,
  "end": 19.44,
  "text": "Pero hay una regla."
 },
 {
  "i": 8,
  "start": 19.96,
  "end": 20.9,
  "text": "Tu cuerpo creció."
 },
 {
  "i": 9,
  "start": 21.42,
  "end": 22.7,
  "text": "Tus rodillas, no."
 },
 {
  "i": 10,
  "start": 23.22,
  "end": 25.82,
  "text": "Tu peso crece más rápido que tus huesos."
 },
 {
  "i": 11,
  "start": 26.26,
  "end": 29.34,
  "text": "¿Y qué pasaría si fueras la persona más alta del mundo?"
 },
 {
  "i": 12,
  "start": 29.34,
  "end": 34.16,
  "text": "A favor, un aro de básquet está a tres metros con cinco centímetros."
 },
 {
  "i": 13,
  "start": 34.66,
  "end": 36.62,
  "text": "Lo tocas sin saltar."
 },
 {
  "i": 14,
  "start": 37.06,
  "end": 39.92,
  "text": "En contra, las puertas miden unos dos metros."
 },
 {
  "i": 15,
  "start": 40.5,
  "end": 41.52,
  "text": "Tu frente lo sabe."
 },
 {
  "i": 16,
  "start": 42.08,
  "end": 44.48,
  "text": "Las camas suelen medir un metro noventa."
 },
 {
  "i": 17,
  "start": 44.94,
  "end": 45.38,
  "text": "¿El problema?"
 },
 {
  "i": 18,
  "start": 45.94,
  "end": 48.56,
  "text": "Tu corazón empuja sangre mucho más arriba."
 },
 {
  "i": 19,
  "start": 49.2,
  "end": 50.06,
  "text": "Y la gente mira."
 },
 {
  "i": 20,
  "start": 50.62,
  "end": 51.38,
  "text": "¿Tu hermanito Leo?"
 },
 {
  "i": 21,
  "start": 51.7,
  "end": 51.82,
  "text": "No."
 },
 {
  "i": 22,
  "start": 52.26,
  "end": 53.88,
  "text": "Él pregunta siempre lo mismo."
 },
 {
  "i": 23,
  "start": 54.42,
  "end": 55.8,
  "text": "¿Cómo está el clima allá arriba?"
 },
 {
  "i": 24,
  "start": 56.4,
  "end": 60.44,
  "text": "En la feria, entre miles de personas, Leo desaparece."
 },
 {
  "i": 25,
  "start": 60.88,
  "end": 61.8,
  "text": "Tu celular suena."
 },
 {
  "i": 26,
  "start": 62.26,
  "end": 62.88,
  "text": "El entrenador."
 },
 {
  "i": 27,
  "start": 63.32,
  "end": 64.92,
  "text": "Prueba final en diez minutos."
 },
 {
  "i": 28,
  "start": 65.46,
  "end": 66.38,
  "text": "No puedes correr."
 },
 {
  "i": 29,
  "start": 66.9,
  "end": 68.42,
  "text": "Tus rodillas no aguantan."
 },
 {
  "i": 30,
  "start": 68.9,
  "end": 71.64,
  "text": "El contrato o tu hermano cuelgas."
 },
 {
  "i": 31,
  "start": 72.2,
  "end": 73.36,
  "text": "Te subes a una banca."
 },
 {
  "i": 32,
  "start": 73.84,
  "end": 75.9,
  "text": "Tus ojos quedan a casi tres metros."
 },
 {
  "i": 33,
  "start": 76.48,
  "end": 78.42,
  "text": "Una gorra roja llorando."
 },
 {
  "i": 34,
  "start": 78.86,
  "end": 79.7,
  "text": "Lo levantas."
 },
 {
  "i": 35,
  "start": 80.14,
  "end": 81.58,
  "text": "¿Cómo está el clima allá arriba?"
 },
 {
  "i": 36,
  "start": 82.14,
  "end": 83.02,
  "text": "Despejado, Leo."
 },
 {
  "i": 37,
  "start": 83.5,
  "end": 85.58,
  "text": "Ahora sí, llega un mensaje."
 },
 {
  "i": 38,
  "start": 85.58,
  "end": 88.56,
  "text": "Alguien más alto que tú te está buscando."
 },
 {
  "i": 39,
  "start": 89.36,
  "end": 90.96,
  "text": "¿Y tú qué harías con esa altura?"
 },
 {
  "i": 40,
  "start": 91.54,
  "end": 93.86,
  "text": "Cuéntanos qué alcanzarías primero en los comentarios."
 },
 {
  "i": 41,
  "start": 94.4,
  "end": 98.78,
  "text": "Y si Leo te sacó una sonrisa, dale like y suscríbete para la parte dos."
 }
]